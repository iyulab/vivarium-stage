<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!--
      xUnit1051 wants TestContext.Current.CancellationToken threaded through every
      call that accepts one, so a cancelled run stops promptly. This suite is
      in-process and finishes in well under a second; the responsiveness the rule
      buys does not exist here, while the token would appear on roughly a hundred
      awaits in tests whose readability is the point. Scoped off deliberately —
      remove this line and thread the token if the suite ever grows slow enough
      for cancellation to matter.
    -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Vivarium.Stage\Vivarium.Stage.csproj" />
  </ItemGroup>

</Project>